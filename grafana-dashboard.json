{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus scraping Sentinel-Alert /metrics",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 0,
  "title": "Sentinel-Alert",
  "uid": "sentinel-alert",
  "tags": ["sentinel", "security"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "time": { "from": "now-24h", "to": "now" },
  "refresh": "30s",
  "templating": { "list": [] },
  "panels": [
    {
      "type": "stat",
      "title": "Attacks today",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [{ "expr": "sentinel_attacks_today", "refId": "A" }],
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 1000 }, { "color": "red", "value": 5000 }] } } }
    },
    {
      "type": "stat",
      "title": "Attacks last hour",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [{ "expr": "sentinel_attacks_last_hour", "refId": "A" }]
    },
    {
      "type": "stat",
      "title": "Devices online",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "targets": [
        { "expr": "sentinel_devices{state=\"online\"}", "refId": "A" },
        { "expr": "sentinel_devices{state=\"total\"}", "refId": "B" }
      ]
    },
    {
      "type": "gauge",
      "title": "PiHole block %",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "targets": [{ "expr": "sentinel_pihole_block_percent", "refId": "A" }],
      "fieldConfig": { "defaults": { "min": 0, "max": 100, "unit": "percent" } }
    },
    {
      "type": "timeseries",
      "title": "Attack rate by vector (per second)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 9, "w": 18, "x": 0, "y": 4 },
      "targets": [{ "expr": "rate(sentinel_attacks_total[5m])", "legendFormat": "{{vector}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 15, "stacking": { "mode": "normal" } } } }
    },
    {
      "type": "stat",
      "title": "WS clients / PiHole connected",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 9, "w": 6, "x": 18, "y": 4 },
      "targets": [
        { "expr": "sentinel_ws_clients", "legendFormat": "WS clients", "refId": "A" },
        { "expr": "sentinel_pihole_instances_connected", "legendFormat": "PiHole connected", "refId": "B" }
      ]
    },
    {
      "type": "piechart",
      "title": "Attacks total by vector",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 13 },
      "targets": [{ "expr": "sentinel_attacks_total", "legendFormat": "{{vector}}", "refId": "A" }]
    },
    {
      "type": "stat",
      "title": "Uptime",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 13 },
      "targets": [{ "expr": "sentinel_uptime_seconds", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "s" } }
    }
  ]
}
